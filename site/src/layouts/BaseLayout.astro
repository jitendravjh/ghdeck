---
import "../styles/global.css";
import Band from "../components/Band.astro";
import Logo from "../components/Logo.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";

interface Props {
  title?: string;
  description?: string;
  structuredData?: Array<Record<string, unknown>>;
}

const {
  title = "ghdeck",
  description = "All your GitHub work in one list. PRs and issues together, newest first, with conflicts, CI and review state on every row.",
  structuredData = [],
} = Astro.props;

const repo = "https://github.com/jitendravjh/ghdeck";
const sponsors = "https://github.com/sponsors/jitendravjh";
const pageTitle = title === "ghdeck" ? "ghdeck" : `${title} | ghdeck`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL("/og.png", Astro.site ?? Astro.url).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: pageTitle, description, url: canonical },
  ...structuredData,
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/writer-regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plexserif-var-italic.woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ghdeck" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ghdeck, all your GitHub work in one list" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f5f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      (() => {
        const key = "ghdeck-theme";
        const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = localStorage.getItem(key) || preferred;
      })();
    </script>
  </head>
  <body>
    <div class="noise"></div>

    <header class="band site-header">
      <i class="node bl"></i><i class="node br"></i>
      <span class="gutter"></span>
      <span class="rail"></span>
      <div class="hold">
        <i class="node bl"></i><i class="node br"></i>
        <nav class="nav" aria-label="Main">
          <a class="brand" href="/"><Logo /><span>ghdeck</span></a>
          <div class="nav-right">
            <div class="nav-links">
              <a href="/docs/">Docs</a>
              <a href={repo} target="_blank" rel="noopener" aria-label="GitHub"><GitHubIcon /><span class="label">GitHub</span></a>
            </div>
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
              <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 17.2a5.2 5.2 0 1 0 0-10.4 5.2 5.2 0 0 0 0 10.4Zm0-14.7a1 1 0 0 1 1 1v1.2a1 1 0 1 1-2 0V3.5a1 1 0 0 1 1-1Zm0 16.8a1 1 0 0 1 1 1v1.2a1 1 0 1 1-2 0v-1.2a1 1 0 0 1 1-1Zm9.5-8.3a1 1 0 1 1 0 2h-1.2a1 1 0 1 1 0-2h1.2ZM4.7 11a1 1 0 1 1 0 2H3.5a1 1 0 1 1 0-2h1.2Zm13.74-6.44a1 1 0 0 1 0 1.42l-.85.85a1 1 0 0 1-1.42-1.42l.85-.85a1 1 0 0 1 1.42 0ZM7.83 16.17a1 1 0 0 1 0 1.42l-.85.85a1 1 0 0 1-1.42-1.42l.85-.85a1 1 0 0 1 1.42 0Zm9.76 0 .85.85a1 1 0 1 1-1.42 1.42l-.85-.85a1 1 0 0 1 1.42-1.42ZM6.98 4.56l.85.85a1 1 0 0 1-1.42 1.42l-.85-.85a1 1 0 1 1 1.42-1.42Z"/></svg>
              <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M21 14.58A8.2 8.2 0 0 1 9.42 3a9.25 9.25 0 1 0 11.59 11.59Z"/></svg>
            </button>
            <a class="button primary" href="/docs/#homebrew">Install<kbd aria-hidden="true">I</kbd></a>
          </div>
        </nav>
      </div>
      <span class="rail"></span>
      <span class="gutter right"></span>
    </header>

    <main><slot /></main>

    <Band class="site-footer" nodes="t" seed={91}>
      <div class="noise"></div>
      <div class="footer-grid">
        <div class="footer-col footer-about">
          <h3>ghdeck &copy; {year}</h3>
          <hr />
          <p>A terminal dashboard for GitHub. Built by <a href="https://jitendravjh.in" target="_blank" rel="noopener">Jitendra Verma</a>.</p>
          <p><a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT licensed</a></p>
        </div>
        <div class="footer-col">
          <h3>Install</h3>
          <ul>
            <li><a href="/docs/#homebrew">Homebrew</a></li>
            <li><a href="/docs/#install-script">Install script</a></li>
            <li><a href="/docs/#from-source">From source</a></li>
            <li><a href={`${repo}/releases`} target="_blank" rel="noopener">Releases<span class="ext">&#8599;</span></a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Docs</h3>
          <ul>
            <li><a href="/docs/#connect-your-account">Setup</a></li>
            <li><a href="/docs/#commands">Commands</a></li>
            <li><a href="/docs/#filters">Filters</a></li>
            <li><a href="/docs/#keys">Keys</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Project</h3>
          <ul>
            <li><a href={repo} target="_blank" rel="noopener">GitHub<span class="ext">&#8599;</span></a></li>
            <li><a href={`${repo}/issues`} target="_blank" rel="noopener">Issues<span class="ext">&#8599;</span></a></li>
            <li><a href={sponsors} target="_blank" rel="noopener">Sponsor<span class="ext">&#8599;</span></a></li>
          </ul>
        </div>
      </div>
      <div class="engrave" aria-hidden="true">
        <div class="engrave-art"><svg viewBox="0 0 1026 230" fill="none">
          <g transform="translate(-30.42 -58.21) scale(2.3157)">
            <rect x="14" y="26" width="100" height="18" rx="9" />
            <rect x="14" y="55" width="100" height="18" rx="9" />
            <rect x="14" y="84" width="100" height="18" rx="9" />
            <circle cx="27" cy="35" r="7.5" />
            <circle cx="27" cy="64" r="7.5" />
            <circle cx="27" cy="93" r="7.5" />
            <rect x="44" y="30" width="58" height="10" rx="5" />
            <rect x="44" y="59" width="40" height="10" rx="5" />
            <rect x="44" y="88" width="50" height="10" rx="5" />
          </g>
          <text x="267.48" y="177.99">ghdeck</text>
        </svg></div>
      </div>
    </Band>

    <script is:inline>
      (() => {
        for (const pre of document.querySelectorAll("main pre")) {
          if (pre.closest(".terminal") || pre.parentElement?.classList.contains("code-frame")) continue;
          const frame = document.createElement("div");
          frame.className = "code-frame";
          const button = document.createElement("button");
          button.className = "copy-code-button";
          button.type = "button";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy code block");
          pre.parentNode?.insertBefore(frame, pre);
          frame.append(pre, button);
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(pre.textContent || "");
              button.textContent = "Copied";
            } catch {
              button.textContent = "Failed";
            }
            window.setTimeout(() => { button.textContent = "Copy"; }, 1300);
          });
        }
      })();
    </script>

    <script is:inline>
      (() => {
        const links = [...document.querySelectorAll('.docs-nav a[href^="#"], .docs-toc a[href^="#"]')];
        const targets = [...document.querySelectorAll(".prose h2[id], .prose h3[id]")];
        if (!links.length || !targets.length) return;

        // the side nav only lists sections, so a subsection lights up the section it sits in
        const section = new Map();
        let current = null;
        for (const t of targets) {
          if (t.tagName === "H2") current = t.id;
          section.set(t.id, current);
        }

        const mark = (id) => {
          for (const a of links) {
            const want = a.closest(".docs-nav") ? section.get(id) : id;
            a.setAttribute("aria-current", decodeURIComponent(a.hash.slice(1)) === want ? "true" : "false");
          }
        };

        const seen = new Map();
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) seen.set(e.target.id, e.isIntersecting);
            const first = targets.find((t) => seen.get(t.id));
            if (first) mark(first.id);
          },
          { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
        );
        for (const t of targets) io.observe(t);
        mark(targets[0].id);
      })();
    </script>

    <script is:inline>
      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
        if (e.target.closest?.("input, textarea, select, [contenteditable]")) return;
        const key = e.key.toUpperCase();
        const hit = [...document.querySelectorAll("a kbd")].find((k) => k.textContent.trim() === key);
        if (hit) { e.preventDefault(); hit.closest("a").click(); }
      });
    </script>

    <script is:inline>
      (() => {
        const key = "ghdeck-theme";
        document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem(key, next);
        });
      })();
    </script>
  </body>
</html>
