---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings?: Heading[] }
const headings = (Astro.props.headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);
---
{headings.length > 0 && (
  <aside class="toc" aria-label="Table of contents">
    <h2>On this page</h2>
    <ul>
      {headings.map((h) => (
        <li class:list={{ nested: h.depth === 3 }}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}
