---
interface Props { title?: string; html: string; narrow: string; }
const { title = "ghdeck", html, narrow } = Astro.props;
---
<div class="terminal">
  <div class="chrome"><i></i><i></i><i></i><span>{title}</span></div>
  <pre class="term-wide"><code set:html={html} /></pre>
  <pre class="term-narrow"><code set:html={narrow} /></pre>
</div>
