---
interface Props {
  class?: string;
}
const className = Astro.props.class;
---

<svg class={className} viewBox="0 0 128 128" role="img" aria-label="ghdeck">
  <rect x="14" y="26" width="100" height="18" rx="9" fill="currentColor" opacity="0.28" />
  <rect x="14" y="55" width="100" height="18" rx="9" fill="currentColor" opacity="0.28" />
  <rect x="14" y="84" width="100" height="18" rx="9" fill="currentColor" opacity="0.28" />
  <circle cx="27" cy="35" r="7.5" fill="var(--logo-good)" />
  <circle cx="27" cy="64" r="7.5" fill="var(--logo-bad)" />
  <circle cx="27" cy="93" r="7.5" fill="var(--logo-accent)" />
  <rect x="44" y="30" width="58" height="10" rx="5" fill="currentColor" />
  <rect x="44" y="59" width="40" height="10" rx="5" fill="currentColor" />
  <rect x="44" y="88" width="50" height="10" rx="5" fill="currentColor" />
</svg>
