---
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "../components/Band.astro";
import Terminal from "../components/Terminal.astro";

const repo = "https://github.com/jitendravjh/ghdeck";

const termHtml = [
  `<span class="ln"><span class="c"><b class="brand-tab">ghdeck</b></span>  <span class="tabs"><b>ATTENTION NEEDED [4]</b>  OPEN [8]  YOURS [46]  TO REVIEW [0]  ALL [50]</span></span>`,
  `<span class="ln sel"><span class="d"> 2h</span>  <span class="b">[PR]   </span> <span class="rp">screenpipe/screenpipe#6449</span>  <span class="t">fix(meetings): lock live transcription language</span></span>`,
  `<span class="ln sel">             <span class="g">● open</span> <span class="d">·</span> <span class="r">✖ ci</span>   <span class="d">6 comments   jitendravjh commented</span></span>`,
  `<span class="sep"></span>`,
  `<span class="ln"><span class="d"> 3d</span>  <span class="c">[ISSUE]</span> <span class="rp">JuliaEarth/CoordRefSystems.jl#315</span>  <span class="t">Add support for ESPG:28992</span></span>`,
  `<span class="ln">             <span class="r">✖ closed</span>   <span class="d">9 comments   jitendravjh commented</span></span>`,
  `<span class="sep"></span>`,
  `<span class="ln"><span class="d"> 3d</span>  <span class="b">[PR]   </span> <span class="rp">JuliaEarth/CoordRefSystems.jl#373</span>  <span class="t">Add EPSG code for Amersfoort / RD New</span></span>`,
  `<span class="ln">             <span class="m">✔ merged</span> <span class="d">·</span> <span class="g">✔ approved</span>   <span class="d">1 comment   juliohm approved</span></span>`,
  `<span class="sep"></span>`,
  `<span class="ln"><span class="d"> 5d</span>  <span class="b">[PR]   </span> <span class="rp">JuliaGeometry/Meshes.jl#1428</span>  <span class="t">Add conversion between azimuths and tangents</span></span>`,
  `<span class="ln">             <span class="m">✔ merged</span> <span class="d">·</span> <span class="g">✔ approved</span>   <span class="d">3 comments   juliohm approved</span></span>`,
  `<span class="sep"></span>`,
  `<span class="ln"><span class="d">3mo</span>  <span class="b">[PR]   </span> <span class="rp">SciML/NeuralOperators.jl#134</span>  <span class="t">feat: implement CNO (closes #122)</span></span>`,
  `<span class="ln">             <span class="g">● open</span> <span class="d">·</span> <span class="r">! conflict</span>   <span class="d">2 comments   jitendravjh commented</span></span>`,
  `<span class="rule"></span>`,
  `<span class="ln"><span class="u">https://github.com/screenpipe/screenpipe/pull/6449</span></span>`,
  `<span class="ln"><span class="mt">by jitendravjh   +255 -17 in 3 files</span></span>`,
  `<span class="ln"><span class="d">↑↓ move · ←→ filter · enter read · o open · r sync · / search · ? help · q quit</span></span>`,
].join("");

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "ghdeck",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux",
    description:
      "A terminal dashboard for GitHub. PRs and issues in one list, newest first, with conflicts, CI and review state on every row.",
    url: "https://ghdeck.jitendravjh.in/",
    downloadUrl: `${repo}/releases`,
    license: "https://opensource.org/licenses/MIT",
    author: { "@type": "Person", name: "Jitendra Verma" },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
---

<BaseLayout structuredData={structuredData}>
  <Band nodes="b" seed={5}>
    <div class="pat grid"></div>
    <div class="pat glow"></div>
    <section class="hero">
      <div>
        <h1 class="h0">All your GitHub work in one list.</h1>
        <p class="lead">
          PRs and issues together, newest first, with conflicts, failing CI and
          who you are waiting on visible without opening anything.
        </p>
      </div>
      <div class="hero-actions">
        <div class="hero-buttons">
          <a class="button primary" href="/docs/#homebrew">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1ZM2.75 12.5a.75.75 0 0 1 .75.75v.25h9v-.25a.75.75 0 0 1 1.5 0v.5a1.25 1.25 0 0 1-1.25 1.25H3.25A1.25 1.25 0 0 1 2 13.75v-.5a.75.75 0 0 1 .75-.75Z"/></svg>
            Install ghdeck<kbd aria-hidden="true">I</kbd>
          </a>
          <a class="button secondary" href="/docs/">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 2.75A1.75 1.75 0 0 1 3.75 1h5.5A1.75 1.75 0 0 1 11 2.75v10.5A1.75 1.75 0 0 1 9.25 15h-5.5A1.75 1.75 0 0 1 2 13.25V2.75Zm2 1.5a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0 1.5h-3.5A.75.75 0 0 1 4 4.25Zm0 3a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0 1.5h-3.5A.75.75 0 0 1 4 7.25Zm.75 2.25a.75.75 0 0 0 0 1.5H7a.75.75 0 0 0 0-1.5H4.75ZM12.5 4.5a.75.75 0 0 1 .75.75v8a.75.75 0 0 1-1.5 0v-8a.75.75 0 0 1 .75-.75Z"/></svg>
            Read the docs<kbd aria-hidden="true">D</kbd>
          </a>
        </div>
        <p class="hero-note">Free and open source. macOS and Linux.</p>
      </div>
    </section>
  </Band>

  <Band nodes="b" seed={23}>
    <div class="strip">
      <div>
        <h3>One list</h3>
        <p>PRs and issues interleaved, newest first. An issue and the pull request that closed it, next to each other.</p>
      </div>
      <div>
        <h3>Status GitHub hides</h3>
        <p>Merge conflicts, CI rollup and review decisions on every row. GitHub search cannot even query conflicts.</p>
      </div>
      <div>
        <h3>Opens instantly</h3>
        <p>Everything sits in SQLite. Cached data shows straight away while a sync runs behind you.</p>
      </div>
    </div>
  </Band>

  <Band nodes="b" seed={47}>
    <div style="padding:24px">
      <Terminal title="ghdeck" html={termHtml} />
    </div>
    <p class="caption">
      Failing CI, a closed issue, two merges and a conflict. Nothing here needed a browser tab.
    </p>
  </Band>

  <Band nodes="b" seed={71}>
    <div class="sec-head">
      <hgroup>
        <h2 class="h2">Your work is spread across two pages.</h2>
        <p>
          GitHub keeps pull requests and issues on separate lists, so an issue and
          the pull request that closes it never appear together. Merge conflicts
          are worse, they cannot be searched or filtered for at all.
        </p>
      </hgroup>
      <div class="sec-actions">
        <a class="button ghost" href="/docs/#filters">Filters<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z"/></svg></a>
        <a class="button secondary" href="/docs/#keys">Keys<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z"/></svg></a>
      </div>
    </div>
    <div class="cards">
      <div class="cell">
        <h3>Five filters</h3>
        <p>Attention needed, open, yours, waiting on your review, and everything. Left and right arrows move between them.</p>
      </div>
      <div class="cell">
        <h3>Read the thread</h3>
        <p>Press enter for the body, comments and reviews, with line comments under the review that made them. Bots collapse to one line.</p>
      </div>
    </div>
  </Band>

  <Band nodes="b" seed={97}>
    <div class="pat dots"></div>
    <div class="install">
      <hgroup>
        <h2 class="h2">Install</h2>
        <p>One line on macOS and Linux. Homebrew sorts out your PATH and upgrades.</p>
      </hgroup>
      <pre class="block">brew install jitendravjh/tap/ghdeck</pre>
      <div class="install-actions">
        <a class="button primary" href="/docs/#connect-your-account">Setup guide</a>
        <a class="button secondary" href="/docs/#download-a-binary">Other ways to install</a>
      </div>
    </div>
  </Band>

  <Band nodes="b" seed={131}>
    <div class="sec-head">
      <hgroup>
        <h2 class="h2">Documentation</h2>
        <p>Short and to the point. Install it, connect your account, learn the keys.</p>
      </hgroup>
      <div class="sec-actions">
        <a class="button secondary" href="/docs/">Read the docs<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z"/></svg></a>
      </div>
    </div>
    <div class="cards three">
      <a class="cell" href="/docs/#homebrew">
        <h3>Install</h3>
        <p>Homebrew, or a prebuilt binary for your platform. Nothing to compile.</p>
        <span class="more">Read &rarr;</span>
      </a>
      <a class="cell" href="/docs/#connect-your-account">
        <h3>Setup</h3>
        <p>Sign in with gh, or set a token with the repo scope. Nothing else to configure.</p>
        <span class="more">Read &rarr;</span>
      </a>
      <a class="cell" href="/docs/#commands">
        <h3>Commands and keys</h3>
        <p>Filters, keys, reading a thread, and the commands that print to stdout.</p>
        <span class="more">Read &rarr;</span>
      </a>
    </div>
  </Band>
</BaseLayout>
