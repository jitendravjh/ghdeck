{
  "name": "ghdeck",
  "main": "./worker/index.js",
  // the try page is bundled so /try/<username> can be served without a redirect
  "rules": [{ "type": "Text", "globs": ["**/dist/try/index.html"] }],
  // the github token is set in the dashboard, a deploy would drop it otherwise
  "keep_vars": true,
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // a browser navigation to /try/<username> is not an asset, the worker answers it
    "run_worker_first": ["/try/*"]
  }
}
